    },
    {
      "name": "Kong - rota protegida",
      "description": "Valida o token emitido acima no plugin `jwt` do Kong. Rode antes o `200 - cliente ativo (sem máscara)`.",
      "item": [
        {
          "name": "401 - sem token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401 no gateway', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{protectedUrl}}",
            "description": "Sem Authorization, o plugin jwt recusa antes de a requisição chegar à aplicação."
          }
        },
        {
          "name": "com Bearer token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('não recusado pelo gateway', () => pm.expect(pm.response.code).to.not.eql(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{protectedUrl}}",
            "description": "O Kong valida assinatura HS256, consumer pelo iss e exp. A resposta final depende da aplicação aceitar `type: customer` na rota escolhida."
          }
        }
      ]
    },
    {
      "name": "Local - imagem com RIE",
      "description": "Invoca a imagem rodando local (`docker run -p 9000:8080`) com um evento v1.0 igual ao do Kong. Sem credencial da AWS, a resposta esperada é o 503 de bootstrap.",
      "item": [
        {
          "name": "Evento v1.0 do Kong - 503 sem AWS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invocação aceita pelo RIE', () => pm.response.to.have.status(200));",
                  "pm.test('503 de bootstrap no contrato', () => { const r = pm.response.json(); pm.expect(r.statusCode).to.eql(503); pm.expect(r.headers['x-correlation-id']).to.eql('local-rie#1'); pm.expect(JSON.parse(r.body).error).to.eql('service_unavailable'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"httpMethod\": \"POST\",\n  \"path\": \"/auth\",\n  \"headers\": {\n    \"content-type\": \"application/json\",\n    \"x-correlation-id\": \"local-rie#1\"\n  },\n  \"body\": \"eyJjcGYiOiIxMTE0NDQ3NzczNSJ9\",\n  \"isBase64Encoded\": true,\n  \"requestContext\": {\n    \"requestId\": \"local-req\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rieUrl}}/2015-03-31/functions/function/invocations",
              "host": [
                "{{rieUrl}}"
              ],
              "path": [
                "2015-03-31",
                "functions",
                "function",
                "invocations"
              ]
            },
            "description": "O body está em base64 (`{\"cpf\":\"11144477735\"}`), como o plugin aws-lambda envia por padrão. O status HTTP do RIE é sempre 200; o status do contrato vem em `statusCode`."
          }
        }
      ]
    }
  ]
}
