                  "pm.test('corpo de erro do contrato', () => { const b = pm.response.json(); pm.expect(b.error).to.eql('invalid_request'); pm.expect(b.message).to.eql('CPF inválido'); pm.expect(b.correlationId).to.eql(pm.response.headers.get('x-correlation-id')); });"
